class CoincidenceGUI:
    """
    Sole purpose of this class is to open the GUI controlling the process.
    """
    def __init__(self, oa, mode='manual'):
        self.oa = oa(default_settings=True)
        self.mode = mode
        self.coincidence = CoincidenceFunctions(oa=self.oa, mode=self.mode)
        self.app = QApplication(sys.argv)
        if self.mode == 'auto':
            self.auto_gui_window = AutoCoincidenceGUI(self.oa, self.coincidence)
        elif self.mode == 'manual':
            self.manual_gui_window = ManualCoincidenceGUI(self.oa, self.coincidence)
        else:
            self.error_messagebox("No valid mode selected. Options are 'manual' or 'auto'.")
        self.run()

class CoincidenceFunctions:
    def __init__(self, oa, mode='manual', on_experiment_stopped=None):
        self.oa = oa
        print(self.oa)
        if self.oa.tool != 'Arctis':
            raise RuntimeError("This is not the right tool to run the automated tricoincidence routine.")
        self.imaging = Imaging(self.oa)
        self.mode = mode
        #self.oa.autoloader_control()
        self.position_data = []
        self.data_file = os.path.join(self.oa.folder_path, 'position_data.json')
        self.hfw = 120.0e-6
        self.auto_gis = GisSputterAutomation(self.oa)
        self.lock  = threading.Lock()
        self.coin_stop_event = threading.Event()
        self.pause_not_stop = False
        self.data_callback = None
        self.on_experiment_stopped = on_experiment_stopped
        self.results = None

