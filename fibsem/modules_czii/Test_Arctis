HANDLE_SIZE = 10
class ResizableRectItem(QGraphicsRectItem, QObject):
    rect_changed = pyqtSignal()
    def __init__(self, rect:QRectF, parent:QObject=None):
        super().__init__(parent)
        self.rect_item = QGraphicsRectItem(rect)

        self.setFlags(
            QGraphicsRectItem.ItemIsMovable |
            QGraphicsRectItem.ItemIsSelectable |
            QGraphicsRectItem.ItemSendsGeometryChanges
        )
        self.setBrush(QColor(255, 0, 0, 50))
        self.setPen(QPen(Qt.red, 2))
        self.handles = {}
        self.handle_size = HANDLE_SIZE
        self.handle_selected = None
        self.mouse_press_pos = None
        self.mouse_press_rect = None

    def item(self):
        return self.rect_item

    def boundingRect(self):
        o = self.handle_size / 2
        return self.rect().adjusted(-o, -o, o, o)

    def paint(self, painter, option, widget=None):
        super().paint(painter, option, widget)
        self.updateHandlesPos()
        painter.setBrush(QColor(0, 255, 0))
        for handle, rect in self.handles.items():
            painter.drawRect(rect)
